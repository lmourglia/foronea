{
  "crons": [
    {
      "path": "/api/enviar-correos",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/preforo",
      "destination": "https://docs.google.com/forms/d/e/1FAIpQLSdGZglbmEUszWkfT0jApNeMVhYD73G6qmmZLTQ92UcS-7-_KQ/viewform",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
